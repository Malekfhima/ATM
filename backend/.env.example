# Copiez ce fichier vers .env et adaptez les valeurs si nécessaire

# Chaîne de connexion MongoDB (un replica set est requis pour les virements)
# Exemple local : mongodb://127.0.0.1:27017/atm
MONGODB_URI=mongodb://127.0.0.1:27017/atm

# Secret de signature des jetons JWT (obligatoire pour tout déploiement réel !)
JWT_SECRET=changez-moi-par-un-secret-fort

# Port de l'API
PORT=5000
